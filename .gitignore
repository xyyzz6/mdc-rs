# Rust
/target/
**/*.rs.bk

# 前端
web/node_modules/
web/dist/

# 运行时数据（配置/数据库/密钥）
data/
test_data/
*.db
*.db-shm
*.db-wal
jwt_secret

# 测试产物
server_test*.log
server_live*.log
extracted/
docker_layers/
web/tsconfig.tsbuildinfo

# 改前备份（一次性，不进版本库）
_backup/

# 安卓壳构建产物（gen/android 源码进库，构建输出与本地大文件不进）
shells/mdc-mobile/target/
shells/mdc-mobile/gen/android/app/build/
shells/mdc-mobile/gen/android/.gradle/
shells/mdc-mobile/gen/android/app/src/main/jniLibs/**/*.so
shells/mdc-mobile/gen/android/local.properties

# 本地构建的分发产物
dist/
tools_mumu_adb.exe

# ── 交叉编译与离线镜像产物（开发机产物，NAS 上不参与构建）────────────────
# zig 交叉编译出来的 Linux 静态二进制 + mihomo 内核都落在这里（两个架构共 ~180MB）
build/
# 由 fpk-tools/build_offline_image.sh 从上面的二进制重新拼出来的离线镜像归档，
# 每次出包前会先清旧的再重打，不必入库
fpk/app/image/
# zig-cc wrapper 的调试日志
*.log
__pycache__/

# ── 飞牛 fpk 包 ─────────────────────────────────────────────────────────
# 源码是单一源：fpk/app/src 由 fpk-tools/build.sh 从仓库根同步过来（不手工维护第二份），
# 图标与 fnpack 工具也都是构建产物 —— 全部不入库，否则改一处代码两边不同步。
fpk/app/src/
# fnpack 打出来的中间产物（带版本号的产物在 dist/ 下）
fpk/picklight.fpk
fpk/ICON.PNG
fpk/ICON_256.PNG
fpk/app/ui/images/
fpk-tools/fnpack.exe
# check_contract 的临时解包目录（跑一次上千个文件，别留着）
_check_fpk/
_stale/

# 系统
.DS_Store
Thumbs.db

# Kotlin 编译器错误日志与机器相关生成物
shells/mdc-mobile/gen/android/.kotlin/
shells/mdc-mobile/gen/android/tauri.settings.gradle

# tauri 构建时生成的能力 schema（可随时再生）
shells/mdc-mobile/gen/schemas/

# APK 构建时拷进来的前端产物（每次改前端都会变，别进库）
shells/mdc-mobile/gen/android/app/src/main/assets/app/
