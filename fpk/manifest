appname               = picklight
version               = 0.1.1
display_name          = 拾光 PickLight
desc                  = 扫描 CloudDrive2 挂载的网盘影视目录，按番号刮削元数据（NFO / 海报），并生成 Emby、Jellyfin 可直接扫的 .strm 直链，视频不搬家。安装包自带完整镜像（程序本体 + mihomo 代理内核），安装时直接载入，不联网、不需要编译，一两分钟装完。
platform              = all
source                = thirdparty
maintainer            = picklight
distributor           = picklight
service_port          = 9208
checkport             = true
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = picklight.Application
ctl_stop              = true
disable_authorization_path = true
changelog             = 0.1.1：改为<b>离线镜像</b>安装 —— 程序本体与代理内核都打进 fpk，安装时 docker load，不再在 NAS 上就地编译（旧版要拉 rust 工具链、基础镜像，国内网络下很容易失败）。向导填写 CD2 挂载目录、strm 输出目录与访问端口，首次装完自动写 config.toml。桌面入口端口跟随向导（默认 9208）。

